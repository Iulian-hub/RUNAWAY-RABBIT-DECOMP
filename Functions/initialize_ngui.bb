Function initialize_ngui%()
    Local local0%
    Local local1%
    Local local2%
    font_main = gui_loadfont("gfx/fonts/font", ".png", character_set, $08, $02)
    gui_initialize()
    gui_setfont(font_main)
    brushmain = createbrush(255.0, 255.0, 255.0)
    brushfx(brushmain, $09)
    brushcolor(brushmain, 255.0, 255.0, 255.0)
    brushred = createbrush(255.0, 255.0, 255.0)
    brushfx(brushred, $09)
    brushcolor(brushred, 255.0, 0.0, 0.0)
    brushgreen = createbrush(255.0, 255.0, 255.0)
    brushfx(brushgreen, $09)
    brushcolor(brushgreen, 0.0, 255.0, 0.0)
    brushblue = createbrush(255.0, 255.0, 255.0)
    brushfx(brushblue, $09)
    brushcolor(brushblue, 0.0, 0.0, 255.0)
    brushyellow = createbrush(255.0, 255.0, 255.0)
    brushfx(brushyellow, $09)
    brushcolor(brushyellow, 0.0, 255.0, 255.0)
    local0 = createbrush(255.0, 255.0, 255.0)
    brushcolor(local0, 255.0, 255.0, 255.0)
    brushfx(local0, $09)
    local1 = createbrush(255.0, 255.0, 255.0)
    brushcolor(local1, 0.0, 0.0, 0.0)
    brushfx(local1, $09)
    local2 = loadtexture("gfx/loadbar.bmp", $01)
    gui_whiteout = gui_createsprite(0.0, 0.0, 640.0, 480.0, 0.0, 0.0, 1.0, 1.0, $00)
    paintentity(gui_getobjectentity(gui_whiteout), local0)
    gui_objectorder(gui_whiteout, $FF676980)
    hideentity(gui_getobjectentity(gui_whiteout))
    gui_blackout = gui_createsprite(0.0, 0.0, 640.0, 480.0, 0.0, 0.0, 1.0, 1.0, $00)
    paintentity(gui_getobjectentity(gui_blackout), local1)
    gui_objectorder(gui_blackout, $FF676980)
    hideentity(gui_getobjectentity(gui_blackout))
    Return $00
End Function
